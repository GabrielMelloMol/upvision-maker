#!/bin/sh
# Referências visuais aprovadas (#142). Ficam nos artefatos do workflow "visual" rodado com "atualizar" (não no git:
# são ~40 MB por aprovação). Baixa para tests/visual/referencia/ (ignorada pelo git) e atualiza as listas de
# problemas conhecidos (essas vão para o git).
#   scripts/visual-refs                 a aprovação mais recente
#   scripts/visual-refs <id>            uma execução específica
#   scripts/visual-refs --so windows    só uma plataforma (usado pelo CI)
set -e
cd "$(dirname "$0")/.."
pattern="referencias-*"
[ "$1" = "--so" ] && { pattern="referencias-$2"; shift 2; }
ids="$1"
[ -n "$ids" ] || ids=$(gh run list --workflow visual.yml --event workflow_dispatch --status success --limit 30 --json databaseId --jq '.[].databaseId')
for id in $ids; do
  tmp=$(mktemp -d)
  if gh run download "$id" -p "$pattern" -D "$tmp" 2>/dev/null && ls "$tmp"/*/referencia >/dev/null 2>&1; then
    for d in "$tmp"/*; do
      # cada artefato traz as listas das duas plataformas, mas só a da própria foi gerada nele
      case "$d" in *-macos) so=darwin ;; *-windows) so=win32 ;; *) continue ;; esac
      mkdir -p tests/visual/referencia tests/visual/conhecidos/$so
      cp -R "$d"/referencia/. tests/visual/referencia/
      cp -R "$d"/conhecidos/$so/. tests/visual/conhecidos/$so/ 2>/dev/null || true
    done
    rm -rf "$tmp"
    echo "referências da execução $id"
    exit 0
  fi
  rm -rf "$tmp"
done
echo "nenhuma aprovação com referências (rode Actions → visual com 'atualizar')" >&2
exit 1
