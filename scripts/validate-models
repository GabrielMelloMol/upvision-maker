#!/bin/sh
# Varredura de QA (#90): gera cada Modelo pronto / ferramenta (padrão, mínimo, máximo), confere a geometria, fatia no
# Bambu Studio CLI, no OrcaSlicer CLI e o "Projeto do Bambu Studio" (A1, PLA, um filamento por cor) e atualiza
# docs/QA-modelos.md (+ docs/qa-modelos.json). Resumo da rodada em docs/QA-fatiador.md.
#
#   scripts/validate-models                         tudo
#   scripts/validate-models --groups keychains,plates,party,tools
#   scripts/validate-models --ids nfc,opener --no-slice
#   scripts/validate-models --owners Torno --jobs 4
#   scripts/validate-models --plates [--ids a,b]    só o modo "uma mesa por cor" (#118): cada mesa fatiada nos dois fatiadores
#
# Grupos: keychains, plates, party, home, kitchen, tools. BAMBU_APP=/caminho/BambuStudio.app e ORCA_APP=/caminho/OrcaSlicer.app
# se não estiverem em /Applications (fatiador ausente = pula; brew install --cask orcaslicer).
set -e
cd "$(dirname "$0")/.."
while [ $# -gt 0 ]; do
  case "$1" in
    --ids) export QA_IDS="$2"; shift 2 ;;
    --groups) export QA_GROUPS="$2"; shift 2 ;;
    --owners) export QA_OWNERS="$2"; shift 2 ;;
    --jobs) export QA_JOBS="$2"; shift 2 ;;
    --no-slice) export QA_SLICE=0; shift ;;
    --plates) export QA_PLATES=1; shift ;;
    *) echo "opção desconhecida: $1" >&2; exit 2 ;;
  esac
done
if [ -n "$QA_PLATES" ]; then exec npx vitest run src/qa/plates.qa.test.ts --reporter=dot --silent=false; fi
QA=1 exec npx vitest run src/qa/validate.qa.test.ts --reporter=dot --silent=false
